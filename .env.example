# Keitaro
KEITARO_API_KEY=
KEITARO_BASE_URL=https://tlgk.host/admin_api/v1

# PostgreSQL
POSTGRES_DB=adrobot
POSTGRES_USER=adrobot
POSTGRES_PASSWORD=adrobot

# Backend DB URL (used by SQLAlchemy / Alembic inside the backend container)
DATABASE_URL=postgresql+psycopg2://adrobot:adrobot@db:5432/adrobot

# Безопасность: лимит запросов с одного IP в минуту и разрешённые CORS-origin
RATE_LIMIT_PER_MINUTE=120
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173
